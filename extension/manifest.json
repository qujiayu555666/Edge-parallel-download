{
  "manifest_version": 3,
  "name": "Edge 多线程下载",
  "version": "0.2.0",
  "description": "通过本地下载助手并行下载公开文件，在 Edge 下载列表中统一管理。",
  "key": "",
  "permissions": [
    "downloads",
    "storage",
    "webRequest",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Edge 多线程下载",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "incognito": "not_allowed",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
